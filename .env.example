# ZECTRIX MCP Server 环境变量模板
# 复制为 .env 并按需填写；API Key 请勿提交到公开仓库

# 必填：API Key，在 https://cloud.zectrix.com 开放 API 页创建，形如 zt_xxx
ZECTRIX_API_KEY=zt_xxx

# 可选：默认设备 ID（MAC 地址），单设备场景下工具可不传 deviceId
ZECTRIX_DEVICE_ID=AA:BB:CC:DD:EE:FF

# 可选：云平台基础地址，默认 https://cloud.zectrix.com
# ZECTRIX_BASE_URL=https://cloud.zectrix.com
